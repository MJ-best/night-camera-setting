# Android Release Keystore Configuration Example
# 이 파일을 keystore.properties 로 복사한 뒤 실제 서명 정보로 채우세요.
# (keystore.properties 및 *.jks/*.keystore 파일은 .gitignore로 제외됩니다.)

storeFile=app/nightskyshot-release.keystore
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=nightskyshot
keyPassword=CHANGE_ME_KEY_PASSWORD
